# ==============================================================================
# EvalOps Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your deployment.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# Database
# Use sqlite:///./evalops.db for local development or PostgreSQL for production:
DATABASE_URL=sqlite:///./evalops.db
# DATABASE_URL=postgresql+psycopg://evalops:evalops@localhost:5432/evalops

# Application Environment & Security
ENVIRONMENT=development
# Set a strong, randomly generated 32+ byte string in production:
SECRET_KEY=change-this-in-production-to-a-strong-secret-key-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=evalops_session
RATE_LIMIT_AUTH_PER_MIN=15

# Privacy & Legal Contact
# Configure with your organization's monitored contact email before production:
PRIVACY_CONTACT=privacy@yourdomain.example

# Optional External Model Integration (Strictly Opt-In)
# By default, EvalOps performs deterministic evaluation without external AI providers.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_API_BASE=
MODEL_TIMEOUT_SECONDS=20
MODEL_DATA_DISCLOSURE_ACKNOWLEDGED=false

# Frontend (placed in frontend/.env.local or provided as build environment)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
